<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PaperColor">#FFF5F5F0</Color>
    <Color x:Key="InkColor">#FF1A1A1A</Color>
    <Color x:Key="CardColor">#FFFCFBF6</Color>
    <Color x:Key="CoralColor">#FFE85D4E</Color>
    <Color x:Key="LimeColor">#FFC4D94E</Color>
    <Color x:Key="SkyColor">#FF8BB4F7</Color>
    <Color x:Key="LavenderColor">#FFC5B5E0</Color>
    <Color x:Key="YellowColor">#FFF2D160</Color>
    <Color x:Key="MutedInkColor">#FF67675F</Color>
    <Color x:Key="SubtleLineColor">#FFD8D7CF</Color>

    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
    <SolidColorBrush x:Key="LimeBrush" Color="{StaticResource LimeColor}" />
    <SolidColorBrush x:Key="SkyBrush" Color="{StaticResource SkyColor}" />
    <SolidColorBrush x:Key="LavenderBrush" Color="{StaticResource LavenderColor}" />
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}" />
    <SolidColorBrush x:Key="MutedInkBrush" Color="{StaticResource MutedInkColor}" />
    <SolidColorBrush x:Key="SubtleLineBrush" Color="{StaticResource SubtleLineColor}" />
</ResourceDictionary>
