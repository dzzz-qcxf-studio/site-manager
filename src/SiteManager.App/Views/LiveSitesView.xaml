<UserControl x:Class="SiteManager.App.Views.LiveSitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource FieldTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索名称、备注或链接" />
            <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="同步" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="4" Style="{StaticResource OutlineButton}" Content="复制链接" Command="{Binding CopyLinkCommand}" />
            <Button Grid.Column="6" Style="{StaticResource OutlineButton}" Content="打开" Command="{Binding OpenLinkCommand}" />
            <Button Grid.Column="8" Style="{StaticResource OutlineButton}" Content="更新" Command="{Binding UpdateCommand}" />
            <Button Grid.Column="10" Style="{StaticResource OutlineButton}" Content="移入回收站" Command="{Binding MoveToTrashCommand}" />
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="18">
            <Grid>
                <ListBox ItemsSource="{Binding FilteredSites}" SelectedItem="{Binding SelectedSite}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SiteListItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" /><TextBlock Text="{Binding Note}" Margin="0,4,0,0" Foreground="{StaticResource MutedInkBrush}" /><TextBlock Text="{Binding Slug, StringFormat=/s/{0}/}" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><Border Background="{StaticResource SkyBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" CornerRadius="12" Padding="8,3"><TextBlock Text="{Binding Version, StringFormat=版本 {0}}" FontSize="11" FontWeight="Bold" /></Border><TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Margin="0,8,0,0" Foreground="{StaticResource MutedInkBrush}" FontSize="11" /></StackPanel></Grid></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="76" Height="60" Background="{StaticResource SkyBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" CornerRadius="14">
                        <TextBlock Text="&lt;/&gt;" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="尚未同步任何网站" Margin="0,16,0,0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="完成服务器连接后，点击“同步”即可获取当前网站清单。" Margin="0,7,0,0" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="正在同步服务器清单…" FontSize="16" FontWeight="Bold" /></StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CoralBrush}" VerticalAlignment="Bottom" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
