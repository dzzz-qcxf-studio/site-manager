<UserControl x:Class="SiteManager.App.Views.TrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Button Style="{StaticResource OutlineButton}" Content="同步回收站" Command="{Binding RefreshCommand}" /><Button Margin="12,0,0,0" Style="{StaticResource OutlineButton}" Content="恢复" Command="{Binding RestoreCommand}" /><Button Margin="12,0,0,0" Style="{StaticResource PrimaryButton}" Content="永久删除" Command="{Binding PurgeCommand}" /></StackPanel>
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="18"><Grid><ListBox ItemsSource="{Binding TrashSites}" SelectedItem="{Binding SelectedTrashSite}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,8" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border HorizontalAlignment="Stretch" Padding="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" CornerRadius="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" /><TextBlock Text="{Binding Note}" Margin="0,4,0,0" Foreground="{StaticResource MutedInkBrush}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="将在以下时间清理" FontSize="11" Foreground="{StaticResource MutedInkBrush}" /><TextBlock Text="{Binding PurgeAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontWeight="Bold" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CoralBrush}" VerticalAlignment="Bottom" TextWrapping="Wrap" /></Grid></Border>
    </Grid>
</UserControl>
