<UserControl x:Class="SiteManager.App.Views.TransferCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}" Padding="28">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold" />
                    <TextBlock Text="{Binding Stage}" Margin="0,8,0,0" FontFamily="Consolas" Foreground="{StaticResource MutedInkBrush}" />
                    <ProgressBar Margin="0,20,0,0" Height="18" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding CompletedBytes, StringFormat=已传输 {0:N0} 字节}" Foreground="{StaticResource MutedInkBrush}" /><TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}" FontWeight="Bold" /></Grid>
                    <Border Margin="0,26,0,0" Padding="12" Background="{StaticResource SkyBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" CornerRadius="14"><TextBlock Text="传输会记录阶段和字节进度；网络中断后可从服务器保留的 .partial 文件续传。" TextWrapping="Wrap" /></Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="传输历史" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="暂无传输记录" Margin="0,14,0,0" Foreground="{StaticResource MutedInkBrush}" Visibility="{Binding HasNoHistory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding History}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="2" CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{StaticResource CardBrush}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" /><TextBlock Text="{Binding SourceFolderPath}" Margin="0,4,0,0" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding CompletedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Margin="0,4,0,0" Foreground="{StaticResource MutedInkBrush}" FontSize="11" /></StackPanel>
                                        <Border Grid.Column="1" Padding="8,4" Background="{StaticResource SkyBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" CornerRadius="10"><TextBlock Text="{Binding StatusText}" FontWeight="Bold" /></Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
