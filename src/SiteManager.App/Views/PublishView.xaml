<UserControl x:Class="SiteManager.App.Views.PublishView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <Border Style="{StaticResource CardBorder}" Padding="22"><StackPanel>
            <TextBlock Text="{Binding OperationTitle}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="1. 选择网页文件夹" Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="请输入含有根目录 index.html 的文件夹路径。" Margin="0,6,0,0" Foreground="{StaticResource MutedInkBrush}" />
            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="扫描校验" Command="{Binding ValidateFolderCommand}" /></Grid>
            <Border Margin="0,12,0,0" Padding="10" Background="{StaticResource YellowBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" CornerRadius="12" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
        </StackPanel></Border>
        <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,14,0,0"><StackPanel>
            <TextBlock Text="2. 填写展示信息" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="显示名称" Margin="0,14,0,5" FontWeight="SemiBold" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="备注（可选）" Margin="0,14,0,5" FontWeight="SemiBold" /><TextBox Style="{StaticResource FieldTextBox}" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel></Border>
        <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="准备完成后将安全归档、续传并原子发布。" FontWeight="Bold" /><TextBlock Text="发布中断时会保留检查点，稍后可续传。" Margin="0,5,0,0" Foreground="{StaticResource MutedInkBrush}" /></StackPanel><Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="取消" Command="{Binding CancelCommand}" /><Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="开始上架" Command="{Binding PublishCommand}" /></Grid></Border>
    </StackPanel></ScrollViewer>
</UserControl>
